# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/college-management

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-strong-jwt-secret-change-this
JWT_REFRESH_SECRET=your-very-strong-refresh-secret-change-this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ─── PII Encryption at Rest ───────────────────────────────────────────────────
# Must be a 64-character hex string (32 bytes / 256-bit key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-change-this

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
